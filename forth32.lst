				;
				        ;  66,106
				 ;   GENERIC FORTH FOR 8086 $Revision: 2.148 $
				 ;
				; NASM version of FIG FORTH created by M4 from generic listing.
				;
				%if 0
				%endif
				        ;
				; ########################################################################################
				;                       PREPARATION (no code)
				; ########################################################################################
 = 00000002			FIGREL  EQU     2       ; FIG RELEASE #
 = 00000000			FIGREV  EQU     0       ; FIG REVISION #
 = 00000022			USRVER  EQU     34      ; USER VERSION NUMBER, a digit now
				;
				;       PROTECTION
 = 00000004			CW      EQU     4       ; I.e. for the mode used in Forth, not in the bootcode.
 = 000000FF			PMASK   EQU     0FFH    ; Allow to access only 256 blocks from OFFSET
				;
				;      ASCII CHARACTER EQUIVALENTS
				;
 = 00000020			ABL     EQU     20H     ; SPACE
 = 0000000D			ACR     EQU     0DH     ; CR
 = 0000002E			ADOT    EQU     2EH     ; PERIOD
 = 00000007			BELL    EQU     07H     ; ^G
 = 00000008			BSIN    EQU     08H     ; INPUT DELETE CHARACTER
 = 00000008			BSOUT   EQU     08H     ; OUTPUT BACKSPACE ( ^H )
 = 0000000A			LF      EQU     0AH     ; LINE FEED, USED INTERNALLY AS
				                        ; LINE ENDER
 = 0000000C			FF      EQU     0CH     ; FORM FEED
				;
				;      MEMORY + I/O CONSTANTS
				;
 = 00000002			NBUF    EQU     2       ; NO. OF BUFFERS AKA SCREENS 
 = 00000400			KBBUF   EQU     1024    ;DATA BYTES PER DISK BUFFER
 = 00000100			US      EQU     100H     ; USER VARIABLE SPACE
				
 = 00010000			 RTS     EQU  10000H    ; RETURN STACK & TERM BUFFER 
				;
				 ;
				
				;
				
 = 00000200			BPS     EQU     512             ;Bytes/sector, common to all of MSDOS
 = 00000002			SPB     EQU     KBBUF/BPS
				;
				; PHYSICAL DISK PARAMETERS
				; (not needed for MODERN)
				; (not needed for BOOTHD)
				;
				; Disk parameters: 
				; HD drive 3" 
 = 00000050			TRKS    EQU     80    ;Number of tracks
 = 00000012			SPT     EQU     18    ;Sectors/track
 = 00000002			HEADS   EQU     2     ;Number of heads 
 = 00000002			NFAT    EQU     2     ; Number of FATS
 = 0000000E			SECROOT EQU     0EH   ; Sectors for root directory entry.
 = 00000009			SECFAT  EQU     9     ; Sectors per FAT
 = 000000F0			MEDIA   EQU    0F0H   ; Descriptor byte. Anachronism.
				
				%if 0
				%endif
				
				; Bios specific equates.
 = 00007C00			BOOTADDRESS     EQU     07C00H ; PC jumps to 0:7C00 to boot
 = 00000B40			SPDRV   EQU     HEADS*TRKS*SPT    ; sectors/drive
				        ; Skip boot sector,fats and root dir and first sector of file.
 = 00000022			SECSTRT EQU     1+NFAT*SECFAT + SECROOT + 1
				%if 0
				%endif
				; END  OF PHYSICAL DISK PARAMETERS
				
				;
 = 80000000			BMASK   EQU     80000000H
				
				
				; ENTRY macros to define dictionary headers.
				
				; Initial value of link
 = 00000000			Link    =     0
				
				CODE_ENTRY    MACRO   Label, Count, Ref, Last
				
				N_&Label& DB  Count
				        DB  Ref
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  C_&Label&
				C_&Label&:
				
				ENDM
				
				
				
				.386
				.model flat, c
				
				
				; I/O routines.
				        extern  c_type:PROC
				        extern  c_expec:PROC
				        extern  c_key:PROC
				        extern  c_qterm:PROC
				        extern  c_rslw:PROC
				        extern  c_block_exit:PROC
				        extern  c_block_init:PROC
				 ;
				
				
				
				        ;
				; ########################################################################################
				;                      BOOTCODE    (optional, always real mode)
				; ########################################################################################
				
				; All bootcode must be relocatable and its memory references absolute.
				; Not for the sake of booting, but to allow MSDOS to start the program too. 
				
				        ;    SEGMENT PARA PUBLIC 'CODE'
				        ; CS:;,DS:;,SS:;,ES:;
				    
				
				; ########################################################################################
				;                       ADJUST CODE SEGMENT REGISTER (still real mode)
				; ########################################################################################
				; Required start of .COM program.
				    
				
				; ########################################################################################
				;                       MOVE CODE TO ITS PLACE (still real mode)
				; ########################################################################################
				
				;
				
				; ########################################################################################
				;                       FILL GDT AND SWITCH TO PROTECTED MODE/32 BITS (optional)
				; ########################################################################################
				;
				
				;
				
				;
				
				.stack 4096
 00000000			.code
				PUBLIC figforth
 00000000			figforth proc
				
 00000000  8D 4C 24 04		        LEA     ECX,[ESP+(CW*1)]
 00000004  33 C0		        XOR     EAX,EAX
 00000006  3B 01		        CMP     EAX, DWORD PTR[ECX]
 00000008  74 05		        JZ     ENDIF1
 0000000A  E9 00000118		        JMP     BOOTUP+(CW*2)         ; Warm start
 0000000F			ENDIF1:
 0000000F  E9 0000010B		        JMP     BOOTUP                  ; Cold start
				
				; ########################################################################################
				;                       FORTH ITSELF (entry point : BOOTUP)
				; ########################################################################################
				;
				%if 0
				%endif
				        ;
				%if 0
				%endif
				;
				        ;
				;
				
 00000014  52			DPUSH:  PUSH    EDX
 00000015  50			APUSH:  PUSH    EAX
				
				;
				
				; In 32 bit versions there may be no jumps to NEXT at all 
				; The label NEXT1 is rarely relevant (for _OLDDEBUG_) 
 00000016  AD			NEXT:   LODSD           ;AX <- (IP)
 00000017  8B D8		NEXT1:  MOV     EBX,EAX   ; (W) <- (IP)
				
 00000019  FF 23		        JMP      DWORD PTR[EBX]    ; TO `CFA'
				        ;
				;
				;       Dictionary starts here.
				
 0000001B			DP0:
				;  *********** 
				;  *   LIT   *
				;  *********** 
				;  
 0000001B 83			N_LIT      DB   80H+3
 0000001C  4C 49		         DB      "LI"
 0000001E  D4			         DB     "T"+80H
 0000001F  00000000		         DD    0
 00000023 00000004 R		LIT      DD     $+CW
				                           
 00000027  AD			        LODSD           ; AX <- LITERAL
 00000028  50			        PUSH    EAX
 00000029  AD			        LODSD                 ; NEXT
 0000002A  8B D8		        MOV     EBX,EAX                  
 0000002C  FF 23		        JMP      DWORD PTR[EBX]             ; TO TOP OF STACK
				;
				
				;  *************** 
				;  *   EXECUTE   *
				;  *************** 
				;  
 0000002E 87			N_EXEC      DB   80H+7
 0000002F  45 58 45 43 55	         DB      "EXECUT"
	   54
 00000035  C5			         DB     "E"+80H
 00000036  0000001B R		         DD    N_LIT
 0000003A 00000004 R		EXEC      DD     $+CW
				                           
 0000003E  5B			        POP     EBX      ; GET CFA
 0000003F  FF 23		        JMP      DWORD PTR[EBX]
				;
				
				;  ************** 
				;  *   BRANCH   *
				;  ************** 
				;  
 00000041 86			N_BRAN      DB   80H+6
 00000042  42 52 41 4E 43	         DB      "BRANC"
 00000047  C8			         DB     "H"+80H
 00000048  0000002E R		         DD    N_EXEC
 0000004C 00000004 R		BRAN      DD     $+CW
				                           
 00000050  03 36		BRAN1:  ADD     ESI,[ESI]
 00000052  AD			        LODSD                 ; NEXT
 00000053  8B D8		        MOV     EBX,EAX                  
 00000055  FF 23		        JMP      DWORD PTR[EBX]       ; JUMP TO OFFSET
				;
				
				;  *************** 
				;  *   0BRANCH   *
				;  *************** 
				;  
 00000057 87			N_ZBRAN      DB   80H+7
 00000058  30 42 52 41 4E	         DB      "0BRANC"
	   43
 0000005E  C8			         DB     "H"+80H
 0000005F  00000041 R		         DD    N_BRAN
 00000063 00000004 R		ZBRAN      DD     $+CW
				                           
 00000067  58			        POP     EAX      ; GET STACK VALUE
 00000068  0B C0		        OR      EAX,EAX   ; ZERO?
 0000006A  74 E4		        JZ      BRAN1   ; YES, BRANCH
 0000006C  8D 76 04		        LEA     ESI,[ESI+(CW*1)]
 0000006F  AD			        LODSD                 ; NEXT
 00000070  8B D8		        MOV     EBX,EAX                  
 00000072  FF 23		        JMP      DWORD PTR[EBX]   
				;
				
				;  ************ 
				;  *   NOOP   *
				;  ************ 
				;  
 00000074 84			N_NOOP      DB   80H+4
 00000075  4E 4F 4F		         DB      "NOO"
 00000078  D0			         DB     "P"+80H
 00000079  00000057 R		         DD    N_ZBRAN
 0000007D 00000004 R		NOOP      DD     $+4
				                           
				;      DEBUG STUFF
 00000081 00000004 R		NOP0      DD      $+(CW*1)
 00000085  EB 8F		        JMP SHORT     NEXT
 00000087 00000004 R		NOP1      DD      $+(CW*1)
 0000008B  EB 89		        JMP SHORT     NEXT
 0000008D 00000004 R		NOP2      DD      $+(CW*1)
 00000091  EB 83		        JMP SHORT     NEXT
				;
				
				;  ************** 
				;  *   (LOOP)   *
				;  ************** 
				;  
 00000093 86			N_XLOOP      DB   80H+6
 00000094  28 4C 4F 4F 50	         DB      "(LOOP"
 00000099  A9			         DB     ")"+80H
 0000009A  00000074 R		         DD    N_NOOP
 0000009E 00000004 R		XLOOP      DD     $+CW
				                           
 000000A2  BB 00000001		        MOV     EBX,1    ; INCREMENT
 000000A7  01 5D 00		XLOO1:  ADD     [EBP],EBX ; INDEX = INDEX + INCR
 000000AA  8B 45 00		        MOV     EAX,[EBP] ; GET NEW INDEX
 000000AD  2B 45 04		        SUB     EAX,[EBP+(CW*1)]        ; COMPARE WITH LIMIT
 000000B0  33 C3		        XOR     EAX,EBX   ; TEST SIGN
 000000B2  78 9C		        JS      BRAN1   ; KEEP LOOPING
				;
				;  END OF `DO' LOOP
 000000B4  83 C5 09		        ADD     EBP,BYTE (CW*2)  ; ADJ RETURN STACK
 000000B7  8D 76 04		        LEA     ESI,[ESI+(CW*1)]       ; BYPASS BRANCH OFFSET
 000000BA  AD			        LODSD                 ; NEXT
 000000BB  8B D8		        MOV     EBX,EAX                  
 000000BD  FF 23		        JMP      DWORD PTR[EBX]   
				;
				
				;  *************** 
				;  *   (+LOOP)   *
				;  *************** 
				;  
 000000BF 87			N_XPLOO      DB   80H+7
 000000C0  28 2B 4C 4F 4F	         DB      "(+LOOP"
	   50
 000000C6  A9			         DB     ")"+80H
 000000C7  00000093 R		         DD    N_XLOOP
 000000CB 00000004 R		XPLOO      DD     $+CW
				                           
 000000CF  5B			        POP     EBX      ; GET LOOP VALUE
 000000D0  EB D5		        JMP SHORT     XLOO1
				;
				
				;  ************ 
				;  *   (DO)   *
				;  ************ 
				;  
 000000D2 84			N_XDO      DB   80H+4
 000000D3  28 44 4F		         DB      "(DO"
 000000D6  A9			         DB     ")"+80H
 000000D7  000000BF R		         DD    N_XPLOO
 000000DB 00000004 R		XDO      DD     $+CW
				                           
 000000DF  5A			        POP     EDX      ; INITIAL INDEX VALUE
 000000E0  58			        POP     EAX      ; LIMIT VALUE
 000000E1  87 EC		        XCHG    EBP,ESP   ; GET RETURN STACK
 000000E3  50			        PUSH    EAX
 000000E4  52			        PUSH    EDX
 000000E5  87 EC		        XCHG    EBP,ESP   ; GET PARAMETER STACK
 000000E7  AD			        LODSD                 ; NEXT
 000000E8  8B D8		        MOV     EBX,EAX                  
 000000EA  FF 23		        JMP      DWORD PTR[EBX]   
				;
				
				;  ********* 
				;  *   I   *
				;  ********* 
				;  
 000000EC 81			N_IDO      DB   80H+1
 000000ED  C9			         DB     "I"+80H
 000000EE  000000D2 R		         DD    N_XDO
 000000F2 00000004 R		IDO      DD     $+CW
				                           
 000000F6  8B 45 00		        MOV     EAX,[EBP] ; GET INDEX VALUE
 000000F9  50			        PUSH    EAX
 000000FA  AD			        LODSD                 ; NEXT
 000000FB  8B D8		        MOV     EBX,EAX                  
 000000FD  FF 23		        JMP      DWORD PTR[EBX]             ; TO PARAMETER STACK
				;
				
				;  *************** 
				;  *   +ORIGIN   *
				;  *************** 
				;  
 000000FF 87			N_PORIG      DB   80H+7
 00000100  2B 4F 52 49 47	         DB      "+ORIGI"
	   49
 00000106  CE			         DB     "N"+80H
 00000107  000000EC R		         DD    N_IDO
 0000010B 000006AE R		PORIG      DD     DOCOL
				                           
 0000010F  00000023 R		        DD      LIT
 00000113  00000137 R		        DD      USINI
 00000117  000004CD R		        DD      PLUS
 0000011B  0000042F R		        DD      SEMIS
				;
				;
				;      Initialisation block for user variables through VOC-LINK
				;       <<<<< must be in same order as user variables >>>>>
				;
 0000011F			BOOTUP:
 0000011F  90			        NOP                    ; Fills jump to 4 bytes (for 16 bits code)
 00000120  90			        NOP         ; or to 8 bytes for 32 bits code  
 00000121  90			        NOP 
 00000122  E9 000016ED		        JMP     LCLD     ;VECTOR TO COLD START
 00000127  90			        NOP                    ; Fills jump to 4 bytes (for 16 bits code)
 00000128  90			        NOP         ; or to 8 bytes for 32 bits code  
 00000129  90			        NOP 
 0000012A  E9 000016C1		        JMP     WRM     ; VECTOR TO WARM START
 0000012F  02			        DB      FIGREL  ; FIG RELEASE #
 00000130  00			        DB      FIGREV  ; FIG REVISION #
 00000131  22			        DB      USRVER  ; USER REVISION #
 00000132  0E			        DB      0EH     ; VERSION ATTRIBUTES
 00000133  00000000		        DD 0   ; Fill version info up to two cells. 
 00000137			USINI:
 00000137  0000295F R		        DD      N_TASK ; FIRST DEFINITION 0 
 0000013B  000FF6F0 R		        DD      STRUSA  ; INIT (U0) USER AREA POINTER 1
 0000013F  00000008		        DD      BSIN    ; RUBOUT: get rid of latest char 2
 00000143  000EF6F0 R		        DD      INITS0  ; INIT (S0)         3
 00000147  000FF6F0 R		        DD      INITR0  ; INIT (R0)         4
 0000014B  000EF6F0 R		        DD      STRTIB  ; INIT (TIB)        5
 0000014F  00000020		        DD      32      ; INIT (WIDTH)      6
 00000153  00000000		        DD      0       ; INIT (WARNING)      7
 00000157  00002970 R		        DD      INITDP  ;      INIT (FENCE)  8
 0000015B  00002970 R		        DD      INITDP  ;      INIT (DP)     9
 0000015F  000016F5 R		        DD      FORTH+2+(CW*2)+(CW*1) ;       INIT (VOC-LINK) 10
				
 00000163  00000000		        DD      0       ; INIT (OFFSET) 
				 ;
				;
				;
				;
				;
				;
				;
				;
				;      The following is the CPU's name, printed
				;       during cold start.
				;       The name is 32 bits in base 36.
				;
				;
				
 00000167 000000CD		CPUNM      DD      0CDH,1856H       ; '80386'     12 13 
	   00001856
				;
				;
				;
				;      <<<<< end of data used by cold start >>>>>
 0000016F  000000C8 [		        BYTE    US-($ - USINI) DUP(?)        ; All user can be initialised.
	    00
	   ]
				;
				
				;  ************* 
				;  *   DIGIT   *
				;  ************* 
				;  
 00000237 85			N_DIGIT      DB   80H+5
 00000238  44 49 47 49		         DB      "DIGI"
 0000023C  D4			         DB     "T"+80H
 0000023D  000000FF R		         DD    N_PORIG
 00000241 00000004 R		DIGIT  DD     $+CW
				                           
 00000245  5A			        POP     EDX      ;NUMBER BASE
 00000246  58			        POP     EAX      ;ASCII DIGIT
 00000247  2C 30		        SUB     AL,'0'
 00000249  72 1B		        JB      DIGI2   ;NUMBER ERROR
 0000024B  3C 09		        CMP     AL,9
 0000024D  76 06		        JBE     DIGI1   ;NUMBER = 0 THRU 9
 0000024F  2C 07		        SUB     AL,7
 00000251  3C 0A		        CMP     AL,10   ;NUMBER 'A' THRU 'Z'?
 00000253  72 11		        JB      DIGI2   ;NO
 00000255  3A C2		DIGI1:  CMP     AL,DL   ; COMPARE NUMBER TO BASE
 00000257  73 0D		        JAE     DIGI2   ;NUMBER ERROR
 00000259  2B D2		        SUB     EDX,EDX   ;ZERO
 0000025B  8A D0		        MOV     DL,AL   ;NEW BINARY NUMBER
 0000025D  B0 01		        MOV     AL,1    ;TRUE FLAG
 0000025F  52			        PUSH    EDX
 00000260  50			        PUSH    EAX
 00000261  AD			        LODSD                 ; NEXT
 00000262  8B D8		        MOV     EBX,EAX                  
 00000264  FF 23		        JMP      DWORD PTR[EBX]             ;ADD TO STACK
				;   NUMBER ERROR
 00000266  2B C0		DIGI2:  SUB     EAX,EAX   ;FALSE FLAG
 00000268  50			        PUSH    EAX
 00000269  AD			        LODSD                 ; NEXT
 0000026A  8B D8		        MOV     EBX,EAX                  
 0000026C  FF 23		        JMP      DWORD PTR[EBX]   
				        ;

				;  ************** 
				;  *   (FIND)   *
				;  ************** 
				;  
 0000026E 86			N_PFIND      DB   80H+6
 0000026F  28 46 49 4E 44	         DB      "(FIND"
 00000274  A9			         DB     ")"+80H
 00000275  00000237 R		         DD    N_DIGIT
 00000279 00000004 R		PFIND  DD     $+CW
				                           
				;       MOV     AX,DS
				;       MOV    ES,AX   ;ES = DS
 0000027D  5B			        POP     EBX      ;NFA
 0000027E  59			        POP     ECX      ;STRING ADDR
				;
				;  SEARCH LOOP
 0000027F  8B F9		PFIN1:  MOV     EDI,ECX   ;GET ADDR
 00000281  8A 03		        MOV     AL,[EBX] ;GET WORD LENGTH
 00000283  8A D0		        MOV     DL,AL   ;SAVE WORD LENGTH
 00000285  32 07		        XOR     AL,[EDI]
 00000287  24 3F		        AND     AL,3FH  ;CHECK LENGTHS
 00000289  75 21		        JNZ     PFIN5   ;LENGTHS DIFFER
				
				;
				;   LENGTHS MATCH - CHECK EACH CHARACTER IN NAME
 0000028B  43			PFIN2:  INC     EBX
 0000028C  47			        INC     EDI      ; NEXT CHAR OF NAME
 0000028D  8A 03		        MOV     AL,[EBX]
 0000028F  32 07		        XOR     AL,[EDI] ;COMPARE NAMES
 00000291  02 C0		        ADD     AL,AL   ;THIS WILL BE TEST BIT 8
 00000293  75 1A		        JNZ     PFIN5A  ;NO MATCH
 00000295  F6 03 80		        TEST    BYTE PTR[EBX], 80H  ;Test for Last char of NFA
 00000298  74 F1		        JZ      PFIN2   
				;
				;   FOUND END OF NAME (BIT 8 SET) - A MATCH
 0000029A  83 C3 09		        ADD     EBX, 1+(CW*2); BX = PFA
 0000029D  53			        PUSH    EBX      ; (S3) <- PFA
 0000029E  B8 00000001		        MOV     EAX,1    ;TRUE VALUE
 000002A3  2A F6		        SUB     DH,DH
 000002A5  52			        PUSH    EDX
 000002A6  50			        PUSH    EAX
 000002A7  AD			        LODSD                 ; NEXT
 000002A8  8B D8		        MOV     EBX,EAX                  
 000002AA  FF 23		        JMP      DWORD PTR[EBX]   
				;
				;   NO NAME MATCH - TRY ANOTHER
				;
				; GET NEXT LINK FIELD ADDR (LFA)
				; ( ZERO = FIRST WORD OF DICTIONARY )
				;
 000002AC  43			PFIN5:  INC     EBX      ;NEXT ADDR
 000002AD  72 06		        JB      PFIN6   ;END OF NAME
 000002AF  8A 03		PFIN5A: MOV     AL,[EBX] ;GET NEXT CHAR
 000002B1  02 C0		        ADD     AL,AL   ;SET/RESET CARRY
 000002B3  EB F7		        JMP SHORT     PFIN5   ;LOOP UNTIL FOUND
				;
 000002B5  8B 1B		PFIN6:  MOV     EBX,[EBX] ; GET LINK FIELD ADDR
 000002B7  0B DB		        OR      EBX,EBX   ; START OF DICT ( 0 )
 000002B9  75 C4		        JNZ     PFIN1   ; NO , LOOK MORE
 000002BB  B8 00000000		        MOV     EAX,0    ; FALSE FLAG
 000002C0  50			        PUSH    EAX
 000002C1  AD			        LODSD                 ; NEXT
 000002C2  8B D8		        MOV     EBX,EAX                  
 000002C4  FF 23		        JMP      DWORD PTR[EBX]             ; DONE ( NO MATCH FOUND )
				;
				
				;  *************** 
				;  *   ENCLOSE   *
				;  *************** 
				;  
 000002C6 87			N_ENCL      DB   80H+7
 000002C7  45 4E 43 4C 4F	         DB      "ENCLOS"
	   53
 000002CD  C5			         DB     "E"+80H
 000002CE  0000026E R		         DD    N_PFIND
 000002D2 00000004 R		ENCL  DD     $+CW
				                           
 000002D6  58			        POP     EAX      ;S1 - TERMINATOR CHAR
 000002D7  5B			        POP     EBX      ;S2 - TEXT ADDR
 000002D8  53			        PUSH    EBX      ;ADDR - BACK TO STACK ( IT RHYMES )
 000002D9  B4 00		        MOV     AH,0    ;ZERO
 000002DB  BA FFFFFFFF		        MOV     EDX,-1   ;CHAR OFFSET COUNTER
 000002E0  4B			        DEC     EBX      ;ADDR -1
				;
				;   SCAN TO FIRST NON-TERMINATOR CHARACTER
 000002E1  43			ENCL1:  INC     EBX      ;ADDR+1
 000002E2  42			        INC     EDX      ;COUNT+1
 000002E3  3A 03		        CMP     AL,[EBX]
 000002E5  74 FA		        JZ      ENCL1   ;WAIT FOR NON-TERMINATOR
 000002E7  52			        PUSH    EDX      ;OFFSET TO 1ST TEXT CHAR
 000002E8  3A 23		        CMP     AH,[EBX] ;NULL CHAR?
 000002EA  75 0A		        JNZ     ENCL2   ;NO
				;
				;  FOUND NULL BEFORE 1ST NON-TERM CHAR
 000002EC  8B C2		        MOV     EAX,EDX   ;COPY COUNTER
 000002EE  42			        INC     EDX      ; +1
 000002EF  52			        PUSH    EDX
 000002F0  50			        PUSH    EAX
 000002F1  AD			        LODSD                 ; NEXT
 000002F2  8B D8		        MOV     EBX,EAX                  
 000002F4  FF 23		        JMP      DWORD PTR[EBX]   
				;
				;   FOUND FIRST TEXT CHAR - COUNT THE CHARS
 000002F6  43			ENCL2:  INC     EBX      ; ADDR+1
 000002F7  42			        INC     EDX      ;COUNT+1
