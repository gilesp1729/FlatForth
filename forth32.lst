				%if 1
				        CODE_ENTRY XDO, 80H+4, "(DO", ")"+80H
 000000C0 84		     1	N_XDO DB  80H+4
 000000C1  28 44 4F	     1	        DB  "(DO"
 000000C4  A9		     1	        DB  ")"+80H
 000000C5  000000AD R	     1	        DD  Link
 000000C9 000000CD R	     1	XDO   DD  C_XDO
 000000CD		     1	C_XDO:
				%else
				%endif                           
 000000CD  5A			        POP     EDX      ; INITIAL INDEX VALUE
 000000CE  58			        POP     EAX      ; LIMIT VALUE
 000000CF  87 EC		        XCHG    EBP,ESP   ; GET RETURN STACK
 000000D1  50			        PUSH    EAX
 000000D2  52			        PUSH    EDX
 000000D3  87 EC		        XCHG    EBP,ESP   ; GET PARAMETER STACK
				        NEXT
 000000D5  AD		     1	        LODSD 
 000000D6  8B D8	     1	        MOV     EBX,EAX                  
 000000D8  FF 23	     1	        JMP      DWORD PTR[EBX]   
