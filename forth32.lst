				;       MOV    ES,AX   ;ES = DS
 000001A5  5B			        POP     EBX      ;NFA
 000001A6  59			        POP     ECX      ;STRING ADDR
				;
				;  SEARCH LOOP
 000001A7  8B F9		PFIN1:  MOV     EDI,ECX   ;GET ADDR
 000001A9  8A 03		        MOV     AL,[EBX] ;GET WORD LENGTH
 000001AB  8A D0		        MOV     DL,AL   ;SAVE WORD LENGTH
 000001AD  32 07		        XOR     AL,[EDI]
 000001AF  24 3F		        AND     AL,3FH  ;CHECK LENGTHS
 000001B1  75 21		        JNZ     PFIN5   ;LENGTHS DIFFER
				
				;
				;   LENGTHS MATCH - CHECK EACH CHARACTER IN NAME
 000001B3  43			PFIN2:  INC     EBX
 000001B4  47			        INC     EDI      ; NEXT CHAR OF NAME
 000001B5  8A 03		        MOV     AL,[EBX]
 000001B7  32 07		        XOR     AL,[EDI] ;COMPARE NAMES
 000001B9  02 C0		        ADD     AL,AL   ;THIS WILL BE TEST BIT 8
 000001BB  75 1A		        JNZ     PFIN5A  ;NO MATCH
 000001BD  F6 03 80		        TEST    BYTE PTR[EBX], 80H  ;Test for Last char of NFA
 000001C0  74 F1		        JZ      PFIN2   
