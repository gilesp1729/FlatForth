				; NASM version of FIG FORTH created by M4 from generic listing.
				;
				%if 0
				%endif
				        ;
				; ########################################################################################
				;                       PREPARATION (no code)
				; ########################################################################################
 = 00000002			FIGREL  EQU     2       ; FIG RELEASE #
 = 00000000			FIGREV  EQU     0       ; FIG REVISION #
 = 00000022			USRVER  EQU     34      ; USER VERSION NUMBER, a digit now
				;
				;       PROTECTION
 = 00000004			CW      EQU     4       ; I.e. for the mode used in Forth, not in the bootcode.
 = 000000FF			PMASK   EQU     0FFH    ; Allow to access only 256 blocks from OFFSET
				;
				;      ASCII CHARACTER EQUIVALENTS
				;
 = 00000020			ABL     EQU     20H     ; SPACE
 = 0000000D			ACR     EQU     0DH     ; CR
 = 0000002E			ADOT    EQU     2EH     ; PERIOD
 = 00000007			BELL    EQU     07H     ; ^G
 = 00000008			BSIN    EQU     08H     ; INPUT DELETE CHARACTER
 = 00000008			BSOUT   EQU     08H     ; OUTPUT BACKSPACE ( ^H )
 = 0000000A			LF      EQU     0AH     ; LINE FEED, USED INTERNALLY AS
				                        ; LINE ENDER
 = 0000000C			FF      EQU     0CH     ; FORM FEED
				;
				;      MEMORY + I/O CONSTANTS
				;
 = 00000002			NBUF    EQU     2       ; NO. OF BUFFERS AKA SCREENS 
 = 00000400			KBBUF   EQU     1024    ;DATA BYTES PER DISK BUFFER
 = 00000100			US      EQU     100H     ; USER VARIABLE SPACE
				
 = 00010000			 RTS     EQU  10000H    ; RETURN STACK & TERM BUFFER 
				;
				 ;
				
				;
				
 = 00000200			BPS     EQU     512             ;Bytes/sector, common to all of MSDOS
 = 00000002			SPB     EQU     KBBUF/BPS
				;
				; PHYSICAL DISK PARAMETERS
				; (not needed for MODERN)
				; (not needed for BOOTHD)
				;
				; Disk parameters: 
				; HD drive 3" 
 = 00000050			TRKS    EQU     80    ;Number of tracks
 = 00000012			SPT     EQU     18    ;Sectors/track
 = 00000002			HEADS   EQU     2     ;Number of heads 
 = 00000002			NFAT    EQU     2     ; Number of FATS
 = 0000000E			SECROOT EQU     0EH   ; Sectors for root directory entry.
 = 00000009			SECFAT  EQU     9     ; Sectors per FAT
 = 000000F0			MEDIA   EQU    0F0H   ; Descriptor byte. Anachronism.
				
				%if 0
				%endif
				
				; Bios specific equates.
 = 00007C00			BOOTADDRESS     EQU     07C00H ; PC jumps to 0:7C00 to boot
 = 00000B40			SPDRV   EQU     HEADS*TRKS*SPT    ; sectors/drive
				        ; Skip boot sector,fats and root dir and first sector of file.
 = 00000022			SECSTRT EQU     1+NFAT*SECFAT + SECROOT + 1
				%if 0
				%endif
				; END  OF PHYSICAL DISK PARAMETERS
				
				;
 = 80000000			BMASK   EQU     80000000H
				
				; ########################################################################################
				; ENTRY macros to define dictionary headers. There is one for code immediately
				; following, and another for DOCOL etc. Forth routines.
				; NOTE WELL the C_Label - MASM silently (!) fails on the original code:
				;   label DD $+4
				;
				; with a value of 4 instead of currentlocation + 4. These things, along with bizarre behaviour
				; of colon/no-colon on labels, are sent to try us.
				
				; Initial value of link
 = 00000000			Link    =     0
				
				; Code entry (where code follows directly after entry)
				CODE_ENTRY    MACRO   Label, Count, Ref, Last
				
				N_&Label& DB  Count
				        DB  Ref
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  C_&Label&
				C_&Label&:
				ENDM
				
				; Code entry as above, but with only a 1 character name (there is no Ref).
				; This saves the IFNB test which causes problems with escaping special chars.
				CODE_ENTRY_1  MACRO   Label, Count, Last
				
				N_&Label& DB  Count
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  C_&Label&
				C_&Label&:
				ENDM
				
				; Forth word entry (Docode and other Forth words follow)
				ENTRY    MACRO   Label, Count, Ref, Last, DoCode
				
				N_&Label& DB  Count
				        DB  Ref
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  DoCode
				ENDM
				
				; Forth word entry (1 char version as above)
				ENTRY_1    MACRO   Label, Count, Last, DoCode
				
				N_&Label& DB  Count
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  DoCode
				ENDM
				
				
				; ########################################################################################
				
				.386
				.model flat, c
				
				
				; I/O routines.
				        extern  c_type:PROC
				        extern  c_expec:PROC
				        extern  c_key:PROC
				        extern  c_qterm:PROC
				        extern  c_rslw:PROC
				        extern  c_block_exit:PROC
				        extern  c_block_init:PROC
				 ;
				
				
				
				        ;
				; ########################################################################################
				;                      BOOTCODE    (optional, always real mode)
				; ########################################################################################
				
				; All bootcode must be relocatable and its memory references absolute.
				; Not for the sake of booting, but to allow MSDOS to start the program too. 
				
				        ;    SEGMENT PARA PUBLIC 'CODE'
				        ; CS:;,DS:;,SS:;,ES:;
				    
				
				; ########################################################################################
				;                       ADJUST CODE SEGMENT REGISTER (still real mode)
				; ########################################################################################
				; Required start of .COM program.
				    
				
				; ########################################################################################
				;                       MOVE CODE TO ITS PLACE (still real mode)
				; ########################################################################################
				
				;
				
				; ########################################################################################
				;                       FILL GDT AND SWITCH TO PROTECTED MODE/32 BITS (optional)
				; ########################################################################################
				;
				
				;
				
				;
				
				.stack 4096
 00000000			.code
				PUBLIC figforth
 00000000			figforth proc
				
 00000000  8D 4C 24 04		        LEA     ECX,[ESP+(CW*1)]
 00000004  33 C0		        XOR     EAX,EAX
 00000006  3B 01		        CMP     EAX, DWORD PTR[ECX]
 00000008  74 05		        JZ     ENDIF1
 0000000A  E9 00000108		        JMP     BOOTUP+(CW*2)         ; Warm start
 0000000F			ENDIF1:
 0000000F  E9 000000FB		        JMP     BOOTUP                  ; Cold start
				
				; ########################################################################################
				;                       FORTH ITSELF (entry point : BOOTUP)
				; ########################################################################################
				;
				%if 0
				%endif
