				%endif                           
 00000238  5A			        POP     EDX      ;NUMBER BASE
 00000239  58			        POP     EAX      ;ASCII DIGIT
 0000023A  2C 30		        SUB     AL,'0'
 0000023C  72 1B		        JB      DIGI2   ;NUMBER ERROR
 0000023E  3C 09		        CMP     AL,9
 00000240  76 06		        JBE     DIGI1   ;NUMBER = 0 THRU 9
 00000242  2C 07		        SUB     AL,7
 00000244  3C 0A		        CMP     AL,10   ;NUMBER 'A' THRU 'Z'?
 00000246  72 11		        JB      DIGI2   ;NO
 00000248  3A C2		DIGI1:  CMP     AL,DL   ; COMPARE NUMBER TO BASE
 0000024A  73 0D		        JAE     DIGI2   ;NUMBER ERROR
 0000024C  2B D2		        SUB     EDX,EDX   ;ZERO
 0000024E  8A D0		        MOV     DL,AL   ;NEW BINARY NUMBER
