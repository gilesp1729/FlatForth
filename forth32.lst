 00000252  52			        PUSH    EDX
 00000253  50			        PUSH    EAX
 00000254  AD			        LODSD                 ; NEXT
 00000255  8B D8		        MOV     EBX,EAX                  
 00000257  FF 23		        JMP      DWORD PTR[EBX]             ;ADD TO STACK
