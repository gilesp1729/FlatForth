				;   FOUND END OF NAME (BIT 8 SET) - A MATCH
 000001C2  83 C3 09		        ADD     EBX, 1+(CW*2); BX = PFA
 000001C5  53			        PUSH    EBX      ; (S3) <- PFA
 000001C6  B8 00000001		        MOV     EAX,1    ;TRUE VALUE
 000001CB  2A F6		        SUB     DH,DH
 000001CD  52			        PUSH    EDX
