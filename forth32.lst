	   00001856
				;
				;
				;
				;      <<<<< end of data used by cold start >>>>>
				; Pad out to US (100H) bytes for the CMOVE
 0000015F  000000C8 [		        BYTE    US-($ - USINI) DUP(0)        ; All user can be initialised.
	    00
	   ]
