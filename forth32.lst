				; NASM version of FIG FORTH created by M4 from generic listing.
				;
				%if 0
				%endif
				        ;
				; ########################################################################################
				;                       PREPARATION (no code)
				; ########################################################################################
 = 00000002			FIGREL  EQU     2       ; FIG RELEASE #
 = 00000000			FIGREV  EQU     0       ; FIG REVISION #
 = 00000022			USRVER  EQU     34      ; USER VERSION NUMBER, a digit now
				;
				;       PROTECTION
 = 00000004			CW      EQU     4       ; I.e. for the mode used in Forth, not in the bootcode.
 = 000000FF			PMASK   EQU     0FFH    ; Allow to access only 256 blocks from OFFSET
				;
				;      ASCII CHARACTER EQUIVALENTS
				;
 = 00000020			ABL     EQU     20H     ; SPACE
 = 0000000D			ACR     EQU     0DH     ; CR
 = 0000002E			ADOT    EQU     2EH     ; PERIOD
 = 00000007			BELL    EQU     07H     ; ^G
 = 00000008			BSIN    EQU     08H     ; INPUT DELETE CHARACTER
 = 00000008			BSOUT   EQU     08H     ; OUTPUT BACKSPACE ( ^H )
 = 0000000A			LF      EQU     0AH     ; LINE FEED, USED INTERNALLY AS
				                        ; LINE ENDER
 = 0000000C			FF      EQU     0CH     ; FORM FEED
				;
				;      MEMORY + I/O CONSTANTS
				;
 = 00000002			NBUF    EQU     2       ; NO. OF BUFFERS AKA SCREENS 
 = 00000400			KBBUF   EQU     1024    ;DATA BYTES PER DISK BUFFER
 = 00000100			US      EQU     100H     ; USER VARIABLE SPACE

 = 00010000			 RTS     EQU  10000H    ; RETURN STACK & TERM BUFFER 
				;
				 ;

				;

 = 00000200			BPS     EQU     512             ;Bytes/sector, common to all of MSDOS
 = 00000002			SPB     EQU     KBBUF/BPS
				;
				; PHYSICAL DISK PARAMETERS
				; (not needed for MODERN)
				; (not needed for BOOTHD)
				;
				; Disk parameters: 
				; HD drive 3" 
 = 00000050			TRKS    EQU     80    ;Number of tracks
 = 00000012			SPT     EQU     18    ;Sectors/track
 = 00000002			HEADS   EQU     2     ;Number of heads 
 = 00000002			NFAT    EQU     2     ; Number of FATS
 = 0000000E			SECROOT EQU     0EH   ; Sectors for root directory entry.
 = 00000009			SECFAT  EQU     9     ; Sectors per FAT
 = 000000F0			MEDIA   EQU    0F0H   ; Descriptor byte. Anachronism.

				%if 0
				%endif

				; Bios specific equates.
 = 00007C00			BOOTADDRESS     EQU     07C00H ; PC jumps to 0:7C00 to boot
 = 00000B40			SPDRV   EQU     HEADS*TRKS*SPT    ; sectors/drive
				        ; Skip boot sector,fats and root dir and first sector of file.
 = 00000022			SECSTRT EQU     1+NFAT*SECFAT + SECROOT + 1
				%if 0
				%endif
				; END  OF PHYSICAL DISK PARAMETERS

				;
 = 80000000			BMASK   EQU     80000000H

				; ########################################################################################
				; ENTRY macros to define dictionary headers. There is one for code immediately
				; following, and another for DOCOL etc. Forth routines.
				; NOTE WELL the C_Label - MASM silently (!) fails on the original code:
				;   label DD $+4
				;
				; with a value of 4 instead of currentlocation + 4. These things, along with bizarre behaviour
				; of colon/no-colon on labels, are sent to try us.

				; Initial value of link
 = 00000000			Link    =     0

				; Code entry (where code follows directly after entry)
				CODE_ENTRY    MACRO   Label, Count, Ref, Last

				N_&Label& DB  Count
				        DB  Ref
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  C_&Label&
				C_&Label&:
				ENDM

				; Code entry as above, but with only a 1 character name (there is no Ref).
				; This saves the IFNB test which causes problems with escaping special chars.
				CODE_ENTRY_1  MACRO   Label, Count, Last

				N_&Label& DB  Count
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  C_&Label&
				C_&Label&:
				ENDM

				; Forth word entry (Docode and other Forth words follow)
				ENTRY    MACRO   Label, Count, Ref, Last, DoCode

				N_&Label& DB  Count
				        DB  Ref
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  DoCode
				ENDM

				; Forth word entry (1 char version as above)
				ENTRY_1    MACRO   Label, Count, Last, DoCode

				N_&Label& DB  Count
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  DoCode
				ENDM


				; ########################################################################################

				.386
				.model flat, c


				; I/O routines.
				        extern  c_type:PROC
				        extern  c_expec:PROC
				        extern  c_key:PROC
				        extern  c_qterm:PROC
				        extern  c_rslw:PROC
				        extern  c_block_exit:PROC
				        extern  c_block_init:PROC
				 ;



				        ;
				; ########################################################################################
				;                      BOOTCODE    (optional, always real mode)
				; ########################################################################################

				; All bootcode must be relocatable and its memory references absolute.
				; Not for the sake of booting, but to allow MSDOS to start the program too. 

				        ;    SEGMENT PARA PUBLIC 'CODE'
				        ; CS:;,DS:;,SS:;,ES:;
				    

				; ########################################################################################
				;                       ADJUST CODE SEGMENT REGISTER (still real mode)
				; ########################################################################################
				; Required start of .COM program.
				    

				; ########################################################################################
				;                       MOVE CODE TO ITS PLACE (still real mode)
				; ########################################################################################

				;

				; ########################################################################################
				;                       FILL GDT AND SWITCH TO PROTECTED MODE/32 BITS (optional)
				; ########################################################################################
				;

				;

				;

				.stack 4096
 00000000			.code
				PUBLIC figforth
 00000000			figforth proc

 00000000  8D 4C 24 04		        LEA     ECX,[ESP+(CW*1)]
 00000004  33 C0		        XOR     EAX,EAX
 00000006  3B 01		        CMP     EAX, DWORD PTR[ECX]
 00000008  74 05		        JZ     ENDIF1
 0000000A  E9 00000108		        JMP     BOOTUP+(CW*2)         ; Warm start
 0000000F			ENDIF1:
 0000000F  E9 000000FB		        JMP     BOOTUP                  ; Cold start

				; ########################################################################################
				;                       FORTH ITSELF (entry point : BOOTUP)
				; ########################################################################################
				;
				%if 0
				%endif
				        ;
				%if 0
				%endif
				;
				        ;
				;

 00000014  52			DPUSH:  PUSH    EDX
 00000015  50			APUSH:  PUSH    EAX

				;

				; In 32 bit versions there may be no jumps to NEXT at all 
				; The label NEXT1 is rarely relevant (for _OLDDEBUG_) 
 00000016  AD			NEXT:   LODSD           ;AX <- (IP)
 00000017  8B D8		NEXT1:  MOV     EBX,EAX   ; (W) <- (IP)

 00000019  FF 23		        JMP      DWORD PTR[EBX]    ; TO `CFA'
				        ;
				;
				;       Dictionary starts here.

 0000001B			DP0:
				;  *********** 
				;  *   LIT   *
				;  *********** 
				;  
				%if 1
				        CODE_ENTRY LIT, 80H+3, "LI", "T"+80H
 0000001B 83		     1	N_LIT DB  80H+3
 0000001C  4C 49	     1	        DB  "LI"
 0000001E  D4		     1	        DB  "T"+80H
 0000001F  00000000	     1	        DD  Link
 00000023 00000027 R	     1	LIT   DD  C_LIT
 00000027		     1	C_LIT:
				%else
				%endif                           
 00000027  AD			        LODSD           ; AX <- LITERAL
 00000028  50			        PUSH    EAX
 00000029  AD			        LODSD                 ; NEXT
 0000002A  8B D8		        MOV     EBX,EAX                  
 0000002C  FF 23		        JMP      DWORD PTR[EBX]             ; TO TOP OF STACK
				;

				;  *************** 
				;  *   EXECUTE   *
				;  *************** 
				;  
				%if 1
				        CODE_ENTRY EXEC, 80H+7, "EXECUT", "E"+80H
 0000002E 87		     1	N_EXEC DB  80H+7
 0000002F  45 58 45 43 55    1	        DB  "EXECUT"
	   54
 00000035  C5		     1	        DB  "E"+80H
 00000036  0000001B R	     1	        DD  Link
 0000003A 0000003E R	     1	EXEC   DD  C_EXEC
 0000003E		     1	C_EXEC:
				%else
				%endif                           
 0000003E  5B			        POP     EBX      ; GET CFA
 0000003F  FF 23		        JMP      DWORD PTR[EBX]
				;

				;  ************** 
				;  *   BRANCH   *
				;  ************** 
				;  
				%if 1
				        CODE_ENTRY BRAN, 80H+6, "BRANC", "H"+80H
 00000041 86		     1	N_BRAN DB  80H+6
 00000042  42 52 41 4E 43    1	        DB  "BRANC"
 00000047  C8		     1	        DB  "H"+80H
 00000048  0000002E R	     1	        DD  Link
 0000004C 00000050 R	     1	BRAN   DD  C_BRAN
 00000050		     1	C_BRAN:
				%else
%endif                           
 00000050  03 36		BRAN1:  ADD     ESI,[ESI]
 00000052  AD			        LODSD                 ; NEXT
 00000053  8B D8		        MOV     EBX,EAX                  
 00000055  FF 23		        JMP      DWORD PTR[EBX]       ; JUMP TO OFFSET
				;

				;  *************** 
				;  *   0BRANCH   *
				;  *************** 
				;  
				%if 1
				        CODE_ENTRY ZBRAN, 80H+7, "0BRANC", "H"+80H
 00000057 87		     1	N_ZBRAN DB  80H+7
 00000058  30 42 52 41 4E    1	        DB  "0BRANC"
	   43
 0000005E  C8		     1	        DB  "H"+80H
 0000005F  00000041 R	     1	        DD  Link
 00000063 00000067 R	     1	ZBRAN   DD  C_ZBRAN
 00000067		     1	C_ZBRAN:
				%else
				%endif                           
 00000067  58			        POP     EAX      ; GET STACK VALUE
 00000068  0B C0		        OR      EAX,EAX   ; ZERO?
 0000006A  74 E4		        JZ      BRAN1   ; YES, BRANCH
 0000006C  8D 76 04		        LEA     ESI,[ESI+(CW*1)]
 0000006F  AD			        LODSD                 ; NEXT
 00000070  8B D8		        MOV     EBX,EAX                  
 00000072  FF 23		        JMP      DWORD PTR[EBX]   
				;

				;  ************ 
				;  *   NOOP   *
				;  ************ 
				;  
				%if 1
				        CODE_ENTRY NOOP, 80H+4, "NOO", "P"+80H
 00000074 84		     1	N_NOOP DB  80H+4
 00000075  4E 4F 4F	     1	        DB  "NOO"
 00000078  D0		     1	        DB  "P"+80H
 00000079  00000057 R	     1	        DD  Link
 0000007D 00000081 R	     1	NOOP   DD  C_NOOP
 00000081		     1	C_NOOP:
				%else
				%endif
				%if 0   ;  Clean out the rubbish.
				%endif
 00000081  EB 93		        JMP SHORT     NEXT
				;

				;  ************** 
				;  *   (LOOP)   *
				;  ************** 
				;  
				%if 1
				        CODE_ENTRY XLOOP, 80H+6, "(LOOP", ")"+80H
 00000083 86		     1	N_XLOOP DB  80H+6
 00000084  28 4C 4F 4F 50    1	        DB  "(LOOP"
 00000089  A9		     1	        DB  ")"+80H
 0000008A  00000074 R	     1	        DD  Link
 0000008E 00000092 R	     1	XLOOP   DD  C_XLOOP
 00000092		     1	C_XLOOP:
				%else
				%endif                           
 00000092  BB 00000001		        MOV     EBX,1    ; INCREMENT
 00000097  01 5D 00		XLOO1:  ADD     [EBP],EBX ; INDEX = INDEX + INCR
 0000009A  8B 45 00		        MOV     EAX,[EBP] ; GET NEW INDEX
 0000009D  2B 45 04		        SUB     EAX,[EBP+(CW*1)]        ; COMPARE WITH LIMIT
 000000A0  33 C3		        XOR     EAX,EBX   ; TEST SIGN
 000000A2  78 AC		        JS      BRAN1   ; KEEP LOOPING
				;
				;  END OF `DO' LOOP
 000000A4  83 C5 09		        ADD     EBP,BYTE (CW*2)  ; ADJ RETURN STACK
 000000A7  8D 76 04		        LEA     ESI,[ESI+(CW*1)]       ; BYPASS BRANCH OFFSET
 000000AA  AD			        LODSD                 ; NEXT
 000000AB  8B D8		        MOV     EBX,EAX                  
 000000AD  FF 23		        JMP      DWORD PTR[EBX]   
				;

				;  *************** 
				;  *   (+LOOP)   *
				;  *************** 
				;  
				%if 1
				        CODE_ENTRY XPLOO, 80H+7, "(+LOOP", ")"+80H
 000000AF 87		     1	N_XPLOO DB  80H+7
 000000B0  28 2B 4C 4F 4F    1	        DB  "(+LOOP"
	   50
 000000B6  A9		     1	        DB  ")"+80H
 000000B7  00000083 R	     1	        DD  Link
 000000BB 000000BF R	     1	XPLOO   DD  C_XPLOO
 000000BF		     1	C_XPLOO:
				%else
				%endif                           
 000000BF  5B			        POP     EBX      ; GET LOOP VALUE
 000000C0  EB D5		        JMP SHORT     XLOO1
				;

				;  ************ 
				;  *   (DO)   *
				;  ************ 
				;  
				%if 1
				        CODE_ENTRY XDO, 80H+4, "(DO", ")"+80H
 000000C2 84		     1	N_XDO DB  80H+4
 000000C3  28 44 4F	     1	        DB  "(DO"
 000000C6  A9		     1	        DB  ")"+80H
 000000C7  000000AF R	     1	        DD  Link
 000000CB 000000CF R	     1	XDO   DD  C_XDO
 000000CF		     1	C_XDO:
				%else
				%endif                           
 000000CF  5A			        POP     EDX      ; INITIAL INDEX VALUE
 000000D0  58			        POP     EAX      ; LIMIT VALUE
 000000D1  87 EC		        XCHG    EBP,ESP   ; GET RETURN STACK
 000000D3  50			        PUSH    EAX
 000000D4  52			        PUSH    EDX
 000000D5  87 EC		        XCHG    EBP,ESP   ; GET PARAMETER STACK
 000000D7  AD			        LODSD                 ; NEXT
 000000D8  8B D8		        MOV     EBX,EAX                  
 000000DA  FF 23		        JMP      DWORD PTR[EBX]   
