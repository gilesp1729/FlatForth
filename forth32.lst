				;  ************** 
				;  *   (FIND)   *
				;  ************** 
				;  
				%if 1
				        CODE_ENTRY PFIND, 80H+6, "(FIND", ")"+80H
 0000025E 86		     1	N_PFIND DB  80H+6
 0000025F  28 46 49 4E 44    1	        DB  "(FIND"
 00000264  A9		     1	        DB  ")"+80H
 00000265  00000227 R	     1	        DD  Link
 00000269 0000026D R	     1	PFIND   DD  C_PFIND
 0000026D		     1	C_PFIND:
				%else
				%endif                           
				;       MOV     AX,DS
				;       MOV    ES,AX   ;ES = DS
 0000026D  5B			        POP     EBX      ;NFA
 0000026E  59			        POP     ECX      ;STRING ADDR
				;
				;  SEARCH LOOP
 0000026F  8B F9		PFIN1:  MOV     EDI,ECX   ;GET ADDR
 00000271  8A 03		        MOV     AL,[EBX] ;GET WORD LENGTH
 00000273  8A D0		        MOV     DL,AL   ;SAVE WORD LENGTH
 00000275  32 07		        XOR     AL,[EDI]
 00000277  24 3F		        AND     AL,3FH  ;CHECK LENGTHS
 00000279  75 21		        JNZ     PFIN5   ;LENGTHS DIFFER

				;
				;   LENGTHS MATCH - CHECK EACH CHARACTER IN NAME
 0000027B  43			PFIN2:  INC     EBX
 0000027C  47			        INC     EDI      ; NEXT CHAR OF NAME
 0000027D  8A 03		        MOV     AL,[EBX]
 0000027F  32 07		        XOR     AL,[EDI] ;COMPARE NAMES
 00000281  02 C0		        ADD     AL,AL   ;THIS WILL BE TEST BIT 8
 00000283  75 1A		        JNZ     PFIN5A  ;NO MATCH
 00000285  F6 03 80		        TEST    BYTE PTR[EBX], 80H  ;Test for Last char of NFA
 00000288  74 F1		        JZ      PFIN2   
				;
				;   FOUND END OF NAME (BIT 8 SET) - A MATCH
 0000028A  83 C3 09		        ADD     EBX, 1+(CW*2); BX = PFA
 0000028D  53			        PUSH    EBX      ; (S3) <- PFA
 0000028E  B8 00000001		        MOV     EAX,1    ;TRUE VALUE
 00000293  2A F6		        SUB     DH,DH
 00000295  52			        PUSH    EDX
 00000296  50			        PUSH    EAX
 00000297  AD			        LODSD                 ; NEXT
 00000298  8B D8		        MOV     EBX,EAX                  
