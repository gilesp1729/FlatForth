				        ;  66,106
				 ;   GENERIC FORTH FOR 8086 $Revision: 2.148 $
				 ; 
				; NASM version of FIG FORTH created by M4 from generic listing.
				;
				%if 0
				%endif
				        ;
				; ########################################################################################
				;                       PREPARATION (no code)
				; ########################################################################################
 = 00000002			FIGREL  EQU     2       ; FIG RELEASE #
 = 00000000			FIGREV  EQU     0       ; FIG REVISION #
 = 00000022			USRVER  EQU     34      ; USER VERSION NUMBER, a digit now
				;
				;       PROTECTION
 = 00000004			CW      EQU     4       ; I.e. for the mode used in Forth, not in the bootcode.
 = 000000FF			PMASK   EQU     0FFH    ; Allow to access only 256 blocks from OFFSET
				;
				;      ASCII CHARACTER EQUIVALENTS
				;
 = 00000020			ABL     EQU     20H     ; SPACE
 = 0000000D			ACR     EQU     0DH     ; CR
 = 0000002E			ADOT    EQU     2EH     ; PERIOD
 = 00000007			BELL    EQU     07H     ; ^G
 = 00000008			BSIN    EQU     08H     ; INPUT DELETE CHARACTER
 = 00000008			BSOUT   EQU     08H     ; OUTPUT BACKSPACE ( ^H )
 = 0000000A			LF      EQU     0AH     ; LINE FEED, USED INTERNALLY AS
				                        ; LINE ENDER
 = 0000000C			FF      EQU     0CH     ; FORM FEED
				;
				;      MEMORY + I/O CONSTANTS
				;
 = 00000008			NBUF    EQU     8       ; NO. OF BUFFERS
 = 00000400			KBBUF   EQU     1024    ;DATA BYTES PER DISK BUFFER
 = 00000100			US      EQU     100H     ; USER VARIABLE SPACE

 = 00010000			RTS     EQU  10000H    ; RETURN STACK & TERM BUFFER 

 = 80000000			BMASK   EQU     80000000H

				; ########################################################################################
				; ENTRY macros to define dictionary headers. There is one for code immediately
				; following, and another for DOCOL etc. Forth routines.
				; NOTE WELL the C_Label - MASM silently (!) fails on the original code:
				;   label DD $+4
				;
				; with a value of 4 instead of currentlocation + 4. These things, along with bizarre behaviour
				; of colon/no-colon on labels, are sent to try us.

				; Initial value of link. Each ENTRY links to the previous one.
 = 00000000			Link    =     0

				; Code entry (where code follows directly after entry)
				CODE_ENTRY    MACRO   Label, Count, Ref, Last

				N_&Label& DB  Count
				        DB  Ref
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  C_&Label&
				C_&Label&:
				ENDM

				; Code entry as above, but with only a 1 character name (there is no Ref).
				; This saves the IFNB test which causes problems with escaping special chars.
				CODE_ENTRY_1  MACRO   Label, Count, Last

				N_&Label& DB  Count
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  C_&Label&
				C_&Label&:
				ENDM

				; Forth word entry (Docode and other Forth words follow)
				ENTRY    MACRO   Label, Count, Ref, Last, DoCode

				N_&Label& DB  Count
				        DB  Ref
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  DoCode
				ENDM

				; Forth word entry (1 char version as above)
				ENTRY_1    MACRO   Label, Count, Last, DoCode

				N_&Label& DB  Count
				        DB  Last
				        DD  Link
				Link    = N_&Label&
				Label   DD  DoCode
				ENDM


				; ########################################################################################

				.386
				.model flat, c


				; I/O routines.
				        extern  c_type:PROC
				        extern  c_expect:PROC
				        extern  c_key:PROC
				        extern  c_qterminal:PROC
				        extern  c_file_open:PROC
				        extern  c_file_close:PROC
				        extern  c_file_read:PROC
				        extern  c_file_write:PROC
				        extern  c_exit:PROC
				 ;



				        ;
				; ########################################################################################
				;                      BOOTCODE   
				; ########################################################################################


				.stack 4096
 00000000			.code
				PUBLIC figforth
 00000000			figforth proc

 00000000  8D 4C 24 04		        LEA     ECX,[ESP+(CW*1)]
 00000004  33 C0		        XOR     EAX,EAX
 00000006  3B 01		        CMP     EAX, DWORD PTR[ECX]
 00000008  74 05		        JZ     ENDIF1
 0000000A  E9 00000106		        JMP     BOOTUP+(CW*2)         ; Warm start
 0000000F			ENDIF1:
 0000000F  E9 000000F9		        JMP     BOOTUP                  ; Cold start

				; ########################################################################################
				;                       FORTH ITSELF (entry point : BOOTUP)
				; ########################################################################################
				;
				%if 0
				%endif
				        ;
				%if 0
				%endif
				;
				        ;
				;

 00000014  52			DPUSH:  PUSH    EDX
 00000015  50			APUSH:  PUSH    EAX

				; ######################################################################
				; NEXT, the Forth address (inner) interpreter.

				; The NEXT macro goes at the end of code words. It is the same code as above.

				NEXT    MACRO
				        LODSD 
				        MOV     EBX,EAX                  
				        JMP      DWORD PTR[EBX]   
				ENDM



				; #######################################################################
				;       Dictionary starts here.

 00000016			DP0:
				;  *********** 
				;  *   LIT   *
				;  *********** 
				;  
				        CODE_ENTRY LIT, 80H+3, "LI", "T"+80H
 00000016 83		     1	N_LIT DB  80H+3
 00000017  4C 49	     1	        DB  "LI"
 00000019  D4		     1	        DB  "T"+80H
 0000001A  00000000	     1	        DD  Link
 0000001E 00000022 R	     1	LIT   DD  C_LIT
 00000022		     1	C_LIT:

 00000022  AD			        LODSD           ; AX <- LITERAL
 00000023  50			        PUSH    EAX
				        NEXT
 00000024  AD		     1	        LODSD 
 00000025  8B D8	     1	        MOV     EBX,EAX                  
 00000027  FF 23	     1	        JMP      DWORD PTR[EBX]   
				;

				;  *************** 
				;  *   EXECUTE   *
				;  *************** 
				;  
				        CODE_ENTRY EXEC, 80H+7, "EXECUT", "E"+80H
 00000029 87		     1	N_EXEC DB  80H+7
 0000002A  45 58 45 43 55    1	        DB  "EXECUT"
	   54
 00000030  C5		     1	        DB  "E"+80H
 00000031  00000016 R	     1	        DD  Link
 00000035 00000039 R	     1	EXEC   DD  C_EXEC
 00000039		     1	C_EXEC:

 00000039  5B			        POP     EBX      ; GET CFA
 0000003A  FF 23		        JMP      DWORD PTR[EBX]
				;

				;  ************** 
				;  *   BRANCH   *
				;  ************** 
				;  
				        CODE_ENTRY BRAN, 80H+6, "BRANC", "H"+80H
 0000003C 86		     1	N_BRAN DB  80H+6
 0000003D  42 52 41 4E 43    1	        DB  "BRANC"
 00000042  C8		     1	        DB  "H"+80H
 00000043  00000029 R	     1	        DD  Link
 00000047 0000004B R	     1	BRAN   DD  C_BRAN
 0000004B		     1	C_BRAN:

 0000004B  03 36		BRAN1:  ADD     ESI,[ESI]
				        NEXT
 0000004D  AD		     1	        LODSD 
 0000004E  8B D8	     1	        MOV     EBX,EAX                  
 00000050  FF 23	     1	        JMP      DWORD PTR[EBX]   
				;

				;  *************** 
				;  *   0BRANCH   *
				;  *************** 
				;  
				        CODE_ENTRY ZBRAN, 80H+7, "0BRANC", "H"+80H
 00000052 87		     1	N_ZBRAN DB  80H+7
 00000053  30 42 52 41 4E    1	        DB  "0BRANC"
	   43
 00000059  C8		     1	        DB  "H"+80H
 0000005A  0000003C R	     1	        DD  Link
 0000005E 00000062 R	     1	ZBRAN   DD  C_ZBRAN
 00000062		     1	C_ZBRAN:
 00000062  58			        POP     EAX      ; GET STACK VALUE
 00000063  0B C0		        OR      EAX,EAX   ; ZERO?
 00000065  74 E4		        JZ      BRAN1   ; YES, BRANCH
 00000067  8D 76 04		        LEA     ESI,[ESI+(CW*1)]
				        NEXT
 0000006A  AD		     1	        LODSD 
 0000006B  8B D8	     1	        MOV     EBX,EAX                  
 0000006D  FF 23	     1	        JMP      DWORD PTR[EBX]   
				;

				;  ************ 
				;  *   NOOP   *
				;  ************ 
				;  
				        CODE_ENTRY NOOP, 80H+4, "NOO", "P"+80H
 0000006F 84		     1	N_NOOP DB  80H+4
 00000070  4E 4F 4F	     1	        DB  "NOO"
 00000073  D0		     1	        DB  "P"+80H
 00000074  00000052 R	     1	        DD  Link
 00000078 0000007C R	     1	NOOP   DD  C_NOOP
 0000007C		     1	C_NOOP:

				        NEXT
 0000007C  AD		     1	        LODSD 
 0000007D  8B D8	     1	        MOV     EBX,EAX                  
 0000007F  FF 23	     1	        JMP      DWORD PTR[EBX]   
				;

				;  ************** 
				;  *   (LOOP)   * 
				;  ************** 
				;  
				        CODE_ENTRY XLOOP, 80H+6, "(LOOP", ")"+80H
 00000081 86		     1	N_XLOOP DB  80H+6
 00000082  28 4C 4F 4F 50    1	        DB  "(LOOP"
 00000087  A9		     1	        DB  ")"+80H
 00000088  0000006F R	     1	        DD  Link
 0000008C 00000090 R	     1	XLOOP   DD  C_XLOOP
 00000090		     1	C_XLOOP:

 00000090  BB 00000001		        MOV     EBX,1    ; INCREMENT
 00000095  01 5D 00		XLOO1:  ADD     [EBP],EBX ; INDEX = INDEX + INCR
 00000098  8B 45 00		        MOV     EAX,[EBP] ; GET NEW INDEX
 0000009B  2B 45 04		        SUB     EAX,[EBP+(CW*1)]        ; COMPARE WITH LIMIT
 0000009E  33 C3		        XOR     EAX,EBX   ; TEST SIGN
 000000A0  78 A9		        JS      BRAN1   ; KEEP LOOPING
				;
				;  END OF `DO' LOOP
 000000A2  83 C5 08		        ADD     EBP,(CW*2)             ; ADJ RETURN STACK
 000000A5  8D 76 04		        LEA     ESI,[ESI+(CW*1)]       ; BYPASS BRANCH OFFSET
				        NEXT
 000000A8  AD		     1	        LODSD 
 000000A9  8B D8	     1	        MOV     EBX,EAX                  
 000000AB  FF 23	     1	        JMP      DWORD PTR[EBX]   
				;

				;  *************** 
				;  *   (+LOOP)   *
				;  *************** 
				;  
				        CODE_ENTRY XPLOO, 80H+7, "(+LOOP", ")"+80H
 000000AD 87		     1	N_XPLOO DB  80H+7
 000000AE  28 2B 4C 4F 4F    1	        DB  "(+LOOP"
	   50
 000000B4  A9		     1	        DB  ")"+80H
 000000B5  00000081 R	     1	        DD  Link
 000000B9 000000BD R	     1	XPLOO   DD  C_XPLOO
 000000BD		     1	C_XPLOO:

 000000BD  5B			        POP     EBX      ; GET LOOP VALUE
 000000BE  EB D5		        JMP SHORT     XLOO1
				;

				;  ************ 
				;  *   (DO)   *
				;  ************ 
				;  
				        CODE_ENTRY XDO, 80H+4, "(DO", ")"+80H
 000000C0 84		     1	N_XDO DB  80H+4
 000000C1  28 44 4F	     1	        DB  "(DO"
 000000C4  A9		     1	        DB  ")"+80H
 000000C5  000000AD R	     1	        DD  Link
 000000C9 000000CD R	     1	XDO   DD  C_XDO
 000000CD		     1	C_XDO:
				                           
 000000CD  5A			        POP     EDX      ; INITIAL INDEX VALUE
 000000CE  58			        POP     EAX      ; LIMIT VALUE
 000000CF  87 EC		        XCHG    EBP,ESP   ; GET RETURN STACK
 000000D1  50			        PUSH    EAX
 000000D2  52			        PUSH    EDX
 000000D3  87 EC		        XCHG    EBP,ESP   ; GET PARAMETER STACK
				        NEXT
 000000D5  AD		     1	        LODSD 
 000000D6  8B D8	     1	        MOV     EBX,EAX                  
 000000D8  FF 23	     1	        JMP      DWORD PTR[EBX]   
				;

				;  ********* 
				;  *   I   *
				;  ********* 
				;  
				        CODE_ENTRY_1 IDO, 80H+1, "I"+80H
 000000DA 81		     1	N_IDO DB  80H+1
 000000DB  C9		     1	        DB  "I"+80H
 000000DC  000000C0 R	     1	        DD  Link
 000000E0 000000E4 R	     1	IDO   DD  C_IDO
 000000E4		     1	C_IDO:
				                           
 000000E4  8B 45 00		        MOV     EAX,[EBP] ; GET INDEX VALUE
 000000E7  50			        PUSH    EAX
				        NEXT
 000000E8  AD		     1	        LODSD 
 000000E9  8B D8	     1	        MOV     EBX,EAX                  
 000000EB  FF 23	     1	        JMP      DWORD PTR[EBX]   
				;

				;  *************** 
				;  *   +ORIGIN   *
				;  *************** 
				;  
				        ENTRY PORIG, 80H+7, "+ORIGI", "N"+80H, DOCOL
 000000ED 87		     1	N_PORIG DB  80H+7
 000000EE  2B 4F 52 49 47    1	        DB  "+ORIGI"
	   49
 000000F4  CE		     1	        DB  "N"+80H
 000000F5  000000DA R	     1	        DD  Link
 000000F9 0000069C R	     1	PORIG   DD  DOCOL
				                           
 000000FD  0000001E R		        DD      LIT
 00000101  00000125 R		        DD      USINI
 00000105  000004BB R		        DD      PLUS
 00000109  0000041D R		        DD      SEMIS
				;
				;
				;      Initialisation block for user variables through VOC-LINK
				;       <<<<< must be in same order as user variables >>>>>
				;
 0000010D			BOOTUP:
 0000010D  90			        NOP                    ; Fills jump to 4 bytes (for 16 bits code)
 0000010E  90			        NOP         ; or to 8 bytes for 32 bits code  
 0000010F  90			        NOP 
 00000110  E9 000016E5		        JMP     LCLD     ;VECTOR TO COLD START
 00000115  90			        NOP                    ; Fills jump to 4 bytes (for 16 bits code)
 00000116  90			        NOP         ; or to 8 bytes for 32 bits code  
 00000117  90			        NOP 
 00000118  E9 000016B9		        JMP     WRM     ; VECTOR TO WARM START
 0000011D  02			        DB      FIGREL  ; FIG RELEASE #
 0000011E  00			        DB      FIGREV  ; FIG REVISION #
 0000011F  22			        DB      USRVER  ; USER REVISION #
 00000120  0E			        DB      0EH     ; VERSION ATTRIBUTES
 00000121  00000000		        DD 0   ; Fill version info up to two cells. 
 00000125			USINI:
 00000125  000026AB R		        DD      N_TASK ; FIRST DEFINITION 0 
 00000129  000FDEC0 R		        DD      STRUSA  ; INIT (U0) USER AREA POINTER 1
 0000012D  00000008		        DD      BSIN    ; RUBOUT: get rid of latest char 2
 00000131  000EDEC0 R		        DD      INITS0  ; INIT (S0)         3
 00000135  000FDEC0 R		        DD      INITR0  ; INIT (R0)         4
 00000139  000EDEC0 R		        DD      STRTIB  ; INIT (TIB)        5
 0000013D  00000020		        DD      32      ; INIT (WIDTH)      6
 00000141  00000000		        DD      0       ; INIT (WARNING)      7
 00000145  000026BC R		        DD      INITDP  ;      INIT (FENCE)  8
 00000149  000026BC R		        DD      INITDP  ;      INIT (DP)     9
 0000014D  000016DB R		        DD      FORTH+2+(CW*2)+(CW*1) ;       INIT (VOC-LINK) 10

 00000151  00000000		        DD      0       ; INIT (OFFSET) 
				 ;
				;
				;
				;
				;
				;
				;
				;
				;      The following is the CPU's name, printed
				;       during cold start.
				;       The name is 32 bits in base 36.
				;
				;

 00000155 000000CD		CPUNM      DD      0CDH,1856H       ; '80386'     12 13 
	   00001856
				;
				;
				;
				;      <<<<< end of data used by cold start >>>>>
				; Pad out to US (100H) bytes for the CMOVE
 0000015D  000000C8 [		        BYTE    US-($ - USINI) DUP(0)        ; All user can be initialised.
	    00
	   ]
				;

				;  ************* 
				;  *   DIGIT   *
				;  ************* 
				;  
				        CODE_ENTRY DIGIT, 80H+5, "DIGI", "T"+80H
 00000225 85		     1	N_DIGIT DB  80H+5
 00000226  44 49 47 49	     1	        DB  "DIGI"
 0000022A  D4		     1	        DB  "T"+80H
 0000022B  000000ED R	     1	        DD  Link
 0000022F 00000233 R	     1	DIGIT   DD  C_DIGIT
 00000233		     1	C_DIGIT:
				                           
 00000233  5A			        POP     EDX      ;NUMBER BASE
 00000234  58			        POP     EAX      ;ASCII DIGIT
 00000235  2C 30		        SUB     AL,'0'
 00000237  72 1B		        JB      DIGI2   ;NUMBER ERROR
 00000239  3C 09		        CMP     AL,9
 0000023B  76 06		        JBE     DIGI1   ;NUMBER = 0 THRU 9
 0000023D  2C 07		        SUB     AL,7
 0000023F  3C 0A		        CMP     AL,10   ;NUMBER 'A' THRU 'Z'?
 00000241  72 11		        JB      DIGI2   ;NO
 00000243  3A C2		DIGI1:  CMP     AL,DL   ; COMPARE NUMBER TO BASE
 00000245  73 0D		        JAE     DIGI2   ;NUMBER ERROR
 00000247  2B D2		        SUB     EDX,EDX   ;ZERO
 00000249  8A D0		        MOV     DL,AL   ;NEW BINARY NUMBER
 0000024B  B0 01		        MOV     AL,1    ;TRUE FLAG
 0000024D  52			        PUSH    EDX
 0000024E  50			        PUSH    EAX
				        NEXT
 0000024F  AD		     1	        LODSD 
 00000250  8B D8	     1	        MOV     EBX,EAX                  
 00000252  FF 23	     1	        JMP      DWORD PTR[EBX]   
				;   NUMBER ERROR
 00000254  2B C0		DIGI2:  SUB     EAX,EAX   ;FALSE FLAG
 00000256  50			        PUSH    EAX
				        NEXT
 00000257  AD		     1	        LODSD 
 00000258  8B D8	     1	        MOV     EBX,EAX                  
 0000025A  FF 23	     1	        JMP      DWORD PTR[EBX]   
				        ;

				;  ************** 
				;  *   (FIND)   *
				;  ************** 
				;  ### TODO: make this (optiomnally) case insensitive.
				        CODE_ENTRY PFIND, 80H+6, "(FIND", ")"+80H
 0000025C 86		     1	N_PFIND DB  80H+6
 0000025D  28 46 49 4E 44    1	        DB  "(FIND"
 00000262  A9		     1	        DB  ")"+80H
 00000263  00000225 R	     1	        DD  Link
 00000267 0000026B R	     1	PFIND   DD  C_PFIND
 0000026B		     1	C_PFIND:
				                           
				;       MOV     AX,DS
				;       MOV    ES,AX   ;ES = DS
 0000026B  5B			        POP     EBX      ;NFA
 0000026C  59			        POP     ECX      ;STRING ADDR
				;
				;  SEARCH LOOP
 0000026D  8B F9		PFIN1:  MOV     EDI,ECX   ;GET ADDR
 0000026F  8A 03		        MOV     AL,[EBX] ;GET WORD LENGTH
 00000271  8A D0		        MOV     DL,AL   ;SAVE WORD LENGTH
 00000273  32 07		        XOR     AL,[EDI]
 00000275  24 3F		        AND     AL,3FH  ;CHECK LENGTHS
 00000277  75 21		        JNZ     PFIN5   ;LENGTHS DIFFER

				;
				;   LENGTHS MATCH - CHECK EACH CHARACTER IN NAME
 00000279  43			PFIN2:  INC     EBX
 0000027A  47			        INC     EDI      ; NEXT CHAR OF NAME
 0000027B  8A 03		        MOV     AL,[EBX]
 0000027D  32 07		        XOR     AL,[EDI] ;COMPARE NAMES
 0000027F  02 C0		        ADD     AL,AL   ;THIS WILL BE TEST BIT 8
 00000281  75 1A		        JNZ     PFIN5A  ;NO MATCH
 00000283  F6 03 80		        TEST    BYTE PTR[EBX], 80H  ;Test for Last char of NFA
 00000286  74 F1		        JZ      PFIN2   
				;
				;   FOUND END OF NAME (BIT 8 SET) - A MATCH
 00000288  83 C3 09		        ADD     EBX, 1+(CW*2); BX = PFA
 0000028B  53			        PUSH    EBX      ; (S3) <- PFA
 0000028C  B8 00000001		        MOV     EAX,1    ;TRUE VALUE
 00000291  2A F6		        SUB     DH,DH
 00000293  52			        PUSH    EDX
 00000294  50			        PUSH    EAX
				        NEXT
 00000295  AD		     1	        LODSD 
 00000296  8B D8	     1	        MOV     EBX,EAX                  
 00000298  FF 23	     1	        JMP      DWORD PTR[EBX]   
				;
				;   NO NAME MATCH - TRY ANOTHER
				;
				; GET NEXT LINK FIELD ADDR (LFA)
				; ( ZERO = FIRST WORD OF DICTIONARY )
				;
 0000029A  43			PFIN5:  INC     EBX      ;NEXT ADDR
 0000029B  72 06		        JB      PFIN6   ;END OF NAME
 0000029D  8A 03		PFIN5A: MOV     AL,[EBX] ;GET NEXT CHAR
 0000029F  02 C0		        ADD     AL,AL   ;SET/RESET CARRY
 000002A1  EB F7		        JMP SHORT     PFIN5   ;LOOP UNTIL FOUND
				;
 000002A3  8B 1B		PFIN6:  MOV     EBX,[EBX] ; GET LINK FIELD ADDR
 000002A5  0B DB		        OR      EBX,EBX   ; START OF DICT ( 0 )
 000002A7  75 C4		        JNZ     PFIN1   ; NO , LOOK MORE
 000002A9  B8 00000000		        MOV     EAX,0    ; FALSE FLAG
 000002AE  50			        PUSH    EAX
				        NEXT
 000002AF  AD		     1	        LODSD 
 000002B0  8B D8	     1	        MOV     EBX,EAX                  
 000002B2  FF 23	     1	        JMP      DWORD PTR[EBX]   
				;

				;  *************** 
				;  *   ENCLOSE   *
				;  *************** 
				;  
				        CODE_ENTRY ENCL, 80H+7, "ENCLOS", "E"+80H
 000002B4 87		     1	N_ENCL DB  80H+7
 000002B5  45 4E 43 4C 4F    1	        DB  "ENCLOS"
	   53
 000002BB  C5		     1	        DB  "E"+80H
 000002BC  0000025C R	     1	        DD  Link
 000002C0 000002C4 R	     1	ENCL   DD  C_ENCL
 000002C4		     1	C_ENCL:
				                           
 000002C4  58			        POP     EAX      ;S1 - TERMINATOR CHAR
 000002C5  5B			        POP     EBX      ;S2 - TEXT ADDR
 000002C6  53			        PUSH    EBX      ;ADDR - BACK TO STACK ( IT RHYMES )
 000002C7  B4 00		        MOV     AH,0    ;ZERO
 000002C9  BA FFFFFFFF		        MOV     EDX,-1   ;CHAR OFFSET COUNTER
 000002CE  4B			        DEC     EBX      ;ADDR -1
				;
				;   SCAN TO FIRST NON-TERMINATOR CHARACTER
