 000000FB 0000069E R	     1	PORIG   DD  DOCOL
				%else
				%endif                           
 000000FF  00000023 R		        DD      LIT
 00000103  00000127 R		        DD      USINI
 00000107  000004BD R		        DD      PLUS
 0000010B  0000041F R		        DD      SEMIS
				;
				;
				;      Initialisation block for user variables through VOC-LINK
				;       <<<<< must be in same order as user variables >>>>>
				;
 0000010F			BOOTUP:
 0000010F  90			        NOP                    ; Fills jump to 4 bytes (for 16 bits code)
 00000110  90			        NOP         ; or to 8 bytes for 32 bits code  
 00000111  90			        NOP 
 00000112  E9 000016ED		        JMP     LCLD     ;VECTOR TO COLD START
 00000117  90			        NOP                    ; Fills jump to 4 bytes (for 16 bits code)
 00000118  90			        NOP         ; or to 8 bytes for 32 bits code  
 00000119  90			        NOP 
 0000011A  E9 000016C1		        JMP     WRM     ; VECTOR TO WARM START
 0000011F  02			        DB      FIGREL  ; FIG RELEASE #
 00000120  00			        DB      FIGREV  ; FIG REVISION #
 00000121  22			        DB      USRVER  ; USER REVISION #
 00000122  0E			        DB      0EH     ; VERSION ATTRIBUTES
 00000123  00000000		        DD 0   ; Fill version info up to two cells. 
 00000127			USINI:
 00000127  0000294F R		        DD      N_TASK ; FIRST DEFINITION 0 
 0000012B  000FF6F0 R		        DD      STRUSA  ; INIT (U0) USER AREA POINTER 1
 0000012F  00000008		        DD      BSIN    ; RUBOUT: get rid of latest char 2
 00000133  000EF6F0 R		        DD      INITS0  ; INIT (S0)         3
 00000137  000FF6F0 R		        DD      INITR0  ; INIT (R0)         4
 0000013B  000EF6F0 R		        DD      STRTIB  ; INIT (TIB)        5
 0000013F  00000020		        DD      32      ; INIT (WIDTH)      6
 00000143  00000000		        DD      0       ; INIT (WARNING)      7
 00000147  00002960 R		        DD      INITDP  ;      INIT (FENCE)  8
 0000014B  00002960 R		        DD      INITDP  ;      INIT (DP)     9
 0000014F  000016E5 R		        DD      FORTH+2+(CW*2)+(CW*1) ;       INIT (VOC-LINK) 10

 00000153  00000000		        DD      0       ; INIT (OFFSET) 
