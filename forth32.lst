				;       MOV     AX,DS
				;       MOV    ES,AX   ;ES = DS
 00000270  5B			        POP     EBX      ;NFA
 00000271  59			        POP     ECX      ;STRING ADDR
				;
				;  SEARCH LOOP
 00000272  8B F9		PFIN1:  MOV     EDI,ECX   ;GET ADDR
 00000274  8A 03		        MOV     AL,[EBX] ;GET WORD LENGTH
 00000276  8A D0		        MOV     DL,AL   ;SAVE WORD LENGTH
 00000278  32 07		        XOR     AL,[EDI]
 0000027A  24 3F		        AND     AL,3FH  ;CHECK LENGTHS
 0000027C  75 21		        JNZ     PFIN5   ;LENGTHS DIFFER

				;
				;   LENGTHS MATCH - CHECK EACH CHARACTER IN NAME
 0000027E  43			PFIN2:  INC     EBX
 0000027F  47			        INC     EDI      ; NEXT CHAR OF NAME
 00000280  8A 03		        MOV     AL,[EBX]
 00000282  32 07		        XOR     AL,[EDI] ;COMPARE NAMES
 00000284  02 C0		        ADD     AL,AL   ;THIS WILL BE TEST BIT 8
 00000286  75 1A		        JNZ     PFIN5A  ;NO MATCH
 00000288  F6 03 80		        TEST    BYTE PTR[EBX], 80H  ;Test for Last char of NFA
 0000028B  74 F1		        JZ      PFIN2   
