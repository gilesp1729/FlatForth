				;  ************* 
				;  
				%if 1
				        CODE_ENTRY DIGIT, 80H+5, "DIGI", "T"+80H
 00000227 85		     1	N_DIGIT DB  80H+5
 00000228  44 49 47 49	     1	        DB  "DIGI"
 0000022C  D4		     1	        DB  "T"+80H
 0000022D  000000EF R	     1	        DD  Link
 00000231 00000235 R	     1	DIGIT   DD  C_DIGIT
 00000235		     1	C_DIGIT:
				%else
				%endif                           
 00000235  5A			        POP     EDX      ;NUMBER BASE
 00000236  58			        POP     EAX      ;ASCII DIGIT
 00000237  2C 30		        SUB     AL,'0'
 00000239  72 1B		        JB      DIGI2   ;NUMBER ERROR
 0000023B  3C 09		        CMP     AL,9
 0000023D  76 06		        JBE     DIGI1   ;NUMBER = 0 THRU 9
 0000023F  2C 07		        SUB     AL,7
 00000241  3C 0A		        CMP     AL,10   ;NUMBER 'A' THRU 'Z'?
 00000243  72 11		        JB      DIGI2   ;NO
 00000245  3A C2		DIGI1:  CMP     AL,DL   ; COMPARE NUMBER TO BASE
 00000247  73 0D		        JAE     DIGI2   ;NUMBER ERROR
 00000249  2B D2		        SUB     EDX,EDX   ;ZERO
 0000024B  8A D0		        MOV     DL,AL   ;NEW BINARY NUMBER
 0000024D  B0 01		        MOV     AL,1    ;TRUE FLAG
 0000024F  52			        PUSH    EDX
 00000250  50			        PUSH    EAX
 00000251  AD			        LODSD                 ; NEXT
 00000252  8B D8		        MOV     EBX,EAX                  
 00000254  FF 23		        JMP      DWORD PTR[EBX]             ;ADD TO STACK
				;   NUMBER ERROR
 00000256  2B C0		DIGI2:  SUB     EAX,EAX   ;FALSE FLAG
 00000258  50			        PUSH    EAX
 00000259  AD			        LODSD                 ; NEXT
 0000025A  8B D8		        MOV     EBX,EAX                  
 0000025C  FF 23		        JMP      DWORD PTR[EBX]   
