 0000016D  5A			        POP     EDX      ;NUMBER BASE
 0000016E  58			        POP     EAX      ;ASCII DIGIT
 0000016F  2C 30		        SUB     AL,'0'
 00000171  72 1B		        JB      DIGI2   ;NUMBER ERROR
 00000173  3C 09		        CMP     AL,9
 00000175  76 06		        JBE     DIGI1   ;NUMBER = 0 THRU 9
 00000177  2C 07		        SUB     AL,7
 00000179  3C 0A		        CMP     AL,10   ;NUMBER 'A' THRU 'Z'?
 0000017B  72 11		        JB      DIGI2   ;NO
