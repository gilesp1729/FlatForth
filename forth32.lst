				%if 1
				        CODE_ENTRY PFIND, 80H+6, "(FIND", ")"+80H
 00000261 86		     1	N_PFIND DB  80H+6
 00000262  28 46 49 4E 44    1	        DB  "(FIND"
 00000267  A9		     1	        DB  ")"+80H
