 00000187  52			        PUSH    EDX
 00000188  50			        PUSH    EAX
 00000189  AD			        LODSD                 ; NEXT
 0000018A  8B D8		        MOV     EBX,EAX                  
 0000018C  FF 23		        JMP      DWORD PTR[EBX]             ;ADD TO STACK
				;   NUMBER ERROR
 0000018E  2B C0		DIGI2:  SUB     EAX,EAX   ;FALSE FLAG
 00000190  50			        PUSH    EAX
 00000191  AD			        LODSD                 ; NEXT
 00000192  8B D8		        MOV     EBX,EAX                  
 00000194  FF 23		        JMP      DWORD PTR[EBX]   
